Group #Root {
  Anchor: (
    Bottom: 32,
    Width: 420,
    Height: 248
  );

  Group #StatusRoot {
    Anchor: (
      Bottom: 96,
      Width: 420,
      Height: 34
    );

    Label #StatusLine1 {
      Anchor: (
        Left: 0,
        Top: 0,
        Width: 420,
        Height: 14
      );
      Visible: false;
      Style: (
        Alignment: Center,
        FontSize: 11,
        RenderBold: true,
        TextColor: #f2f3f8
      );
    }

    Label #StatusLine2 {
      Anchor: (
        Left: 0,
        Top: 16,
        Width: 420,
        Height: 14
      );
