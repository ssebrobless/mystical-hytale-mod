@PanelBg = #101722(0.95);
@PanelSoft = #1a2230(0.90);
@PanelLine = #344052(0.70);
@Text = #eef3f7;
@Muted = #b3bfcb;
@Accent = #d8aa53;
@Good = #98d982;
@Bad = #e08a7a;

@SmallText = (FontSize: 13, TextColor: @Muted, Wrap: true);
@BodyText = (FontSize: 15, TextColor: @Text, Wrap: true);
@TitleText = (FontSize: 26, RenderBold: true, TextColor: @Text);
@ValueText = (FontSize: 15, RenderBold: true, TextColor: @Good, Wrap: true);
@ActiveText = (FontSize: 13, RenderBold: true, TextColor: @Accent, VerticalAlignment: Center);
@NavText = (FontSize: 14, RenderBold: true, TextColor: @Text);
@ButtonStyle = (
  Default: (
    Background: PatchStyle(Color: @PanelSoft),
    LabelStyle: @NavText
  ),
  Hovered: (
    Background: PatchStyle(Color: #263143(0.94)),
    LabelStyle: (...@NavText, TextColor: @Accent)
  ),
  Pressed: (
    Background: PatchStyle(Color: #3a2d1e(0.95)),
    LabelStyle: (...@NavText, TextColor: #ffffff)
  )
);

Group #Root {
  Anchor: (Width: 1040, Height: 704);
  Background: PatchStyle(Color: @PanelBg);

  Group #NavRail {
    Anchor: (Left: 24, Top: 24, Width: 176, Height: 656);
    Background: PatchStyle(Color: #0b1018(0.96));

    Label #Title { Anchor: (Left: 14, Top: 12, Width: 148, Height: 30); Text: "MOTM"; Style: (FontSize: 24, RenderBold: true, TextColor: @Accent); }
    Label #Subtitle { Anchor: (Left: 14, Top: 42, Width: 148, Height: 24); Text: "Creative Sandbox"; Style: @SmallText; }

    TextButton #NavClassesButton { Anchor: (Left: 14, Top: 84, Width: 148, Height: 32); Text: "Classes"; Style: @ButtonStyle; }
    Label #NavClassesSelected { Anchor: (Left: 14, Top: 84, Width: 148, Height: 32); Text: "> Classes"; Visible: false; Style: @ActiveText; }

    TextButton #NavStylesButton { Anchor: (Left: 14, Top: 122, Width: 148, Height: 32); Text: "Styles"; Style: @ButtonStyle; }
    Label #NavStylesSelected { Anchor: (Left: 14, Top: 122, Width: 148, Height: 32); Text: "> Styles"; Visible: false; Style: @ActiveText; }

    TextButton #NavAbilitiesButton { Anchor: (Left: 14, Top: 160, Width: 148, Height: 32); Text: "Abilities"; Style: @ButtonStyle; }
    Label #NavAbilitiesSelected { Anchor: (Left: 14, Top: 160, Width: 148, Height: 32); Text: "> Abilities"; Visible: false; Style: @ActiveText; }

    TextButton #NavPerksButton { Anchor: (Left: 14, Top: 198, Width: 148, Height: 32); Text: "Perks"; Style: @ButtonStyle; }
    Label #NavPerksSelected { Anchor: (Left: 14, Top: 198, Width: 148, Height: 32); Text: "> Perks"; Visible: false; Style: @ActiveText; }

    TextButton #NavTestButton { Anchor: (Left: 14, Top: 236, Width: 148, Height: 32); Text: "Test Lab"; Style: @ButtonStyle; }
    Label #NavTestSelected { Anchor: (Left: 14, Top: 236, Width: 148, Height: 32); Text: "> Test Lab"; Visible: false; Style: @ActiveText; }

    TextButton #NavInfoButton { Anchor: (Left: 14, Top: 274, Width: 148, Height: 32); Text: "Info"; Style: @ButtonStyle; }
    Label #NavInfoSelected { Anchor: (Left: 14, Top: 274, Width: 148, Height: 32); Text: "> Info"; Visible: false; Style: @ActiveText; }

    Label #ActionStatus { Anchor: (Left: 14, Top: 360, Width: 148, Height: 260); Text: ""; Style: (...@SmallText, TextColor: #d9dde7); }
  }

  Group #HeaderPanel {
    Anchor: (Left: 224, Top: 24, Width: 792, Height: 96);
    Background: PatchStyle(Color: @PanelSoft);
    Label #SectionTitle { Anchor: (Left: 20, Top: 12, Width: 480, Height: 32); Style: @TitleText; }
    Label #SectionHint { Anchor: (Left: 20, Top: 50, Width: 480, Height: 34); Style: @SmallText; }
    Label #LoadoutClass { Anchor: (Left: 520, Top: 12, Width: 252, Height: 18); Style: @ValueText; }
    Label #LoadoutStyle { Anchor: (Left: 520, Top: 34, Width: 252, Height: 18); Style: @ValueText; }
    Label #LoadoutPerks { Anchor: (Left: 520, Top: 56, Width: 252, Height: 18); Style: @ValueText; }
    Label #LoadoutLevel { Anchor: (Left: 520, Top: 78, Width: 252, Height: 16); Style: @SmallText; }
  }

  Group #ContentRoot {
    Anchor: (Left: 224, Top: 132, Width: 792, Height: 548);
    Background: PatchStyle(Color: #0f141c(0.92));

    Group #ClassesPanel {
      Anchor: (Left: 18, Top: 18, Width: 756, Height: 512);
      Label #ClassesIntro { Anchor: (Left: 0, Top: 0, Width: 756, Height: 22); Text: "Equip any class instantly. Equipping resets dependent styles/runtime."; Style: @SmallText; }
      Group #ClassRow1 { Anchor: (Left: 0, Top: 34, Width: 756, Height: 96); Background: PatchStyle(Color: @PanelSoft);
        Label #Class1Name { Anchor: (Left: 14, Top: 10, Width: 320, Height: 22); Style: @ValueText; }
        Label #Class1Desc { Anchor: (Left: 14, Top: 36, Width: 460, Height: 50); Style: @SmallText; }
        Label #Class1Active { Anchor: (Left: 500, Top: 10, Width: 110, Height: 22); Text: "EQUIPPED"; Visible: false; Style: @ActiveText; }
        TextButton #Class1EquipButton { Anchor: (Left: 618, Top: 10, Width: 124, Height: 30); Text: "Equip"; Style: @ButtonStyle; }
      }
      Group #ClassRow2 { Anchor: (Left: 0, Top: 138, Width: 756, Height: 96); Background: PatchStyle(Color: @PanelSoft);
        Label #Class2Name { Anchor: (Left: 14, Top: 10, Width: 320, Height: 22); Style: @ValueText; }
        Label #Class2Desc { Anchor: (Left: 14, Top: 36, Width: 460, Height: 50); Style: @SmallText; }
        Label #Class2Active { Anchor: (Left: 500, Top: 10, Width: 110, Height: 22); Text: "EQUIPPED"; Visible: false; Style: @ActiveText; }
        TextButton #Class2EquipButton { Anchor: (Left: 618, Top: 10, Width: 124, Height: 30); Text: "Equip"; Style: @ButtonStyle; }
      }
      Group #ClassRow3 { Anchor: (Left: 0, Top: 242, Width: 756, Height: 96); Background: PatchStyle(Color: @PanelSoft);
        Label #Class3Name { Anchor: (Left: 14, Top: 10, Width: 320, Height: 22); Style: @ValueText; }
        Label #Class3Desc { Anchor: (Left: 14, Top: 36, Width: 460, Height: 50); Style: @SmallText; }
        Label #Class3Active { Anchor: (Left: 500, Top: 10, Width: 110, Height: 22); Text: "EQUIPPED"; Visible: false; Style: @ActiveText; }
        TextButton #Class3EquipButton { Anchor: (Left: 618, Top: 10, Width: 124, Height: 30); Text: "Equip"; Style: @ButtonStyle; }
      }
      Group #ClassRow4 { Anchor: (Left: 0, Top: 346, Width: 756, Height: 96); Background: PatchStyle(Color: @PanelSoft);
