      Group #StyleSlot7 { Anchor: (Left: 0, Top: 198, Width: 372, Height: 34); Label #Style7Name { Anchor: (Left: 8, Top: 0, Width: 210, Height: 32); Style: @BodyText; } Label #Style7Active { Anchor: (Left: 224, Top: 0, Width: 40, Height: 32); Text: "ON"; Visible: false; Style: @ActiveText; } TextButton #Style7EquipButton { Anchor: (Left: 268, Top: 2, Width: 104, Height: 28); Text: "Equip"; Style: @ButtonStyle; } }
      Group #StyleSlot8 { Anchor: (Left: 384, Top: 198, Width: 372, Height: 34); Label #Style8Name { Anchor: (Left: 8, Top: 0, Width: 210, Height: 32); Style: @BodyText; } Label #Style8Active { Anchor: (Left: 224, Top: 0, Width: 40, Height: 32); Text: "ON"; Visible: false; Style: @ActiveText; } TextButton #Style8EquipButton { Anchor: (Left: 268, Top: 2, Width: 104, Height: 28); Text: "Equip"; Style: @ButtonStyle; } }
      Group #StyleSlot9 { Anchor: (Left: 0, Top: 240, Width: 372, Height: 34); Label #Style9Name { Anchor: (Left: 8, Top: 0, Width: 210, Height: 32); Style: @BodyText; } Label #Style9Active { Anchor: (Left: 224, Top: 0, Width: 40, Height: 32); Text: "ON"; Visible: false; Style: @ActiveText; } TextButton #Style9EquipButton { Anchor: (Left: 268, Top: 2, Width: 104, Height: 28); Text: "Equip"; Style: @ButtonStyle; } }
