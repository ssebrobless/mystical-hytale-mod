        Label #Class4Desc { Anchor: (Left: 14, Top: 36, Width: 460, Height: 50); Style: @SmallText; }
        Label #Class4Active { Anchor: (Left: 500, Top: 10, Width: 110, Height: 22); Text: "EQUIPPED"; Visible: false; Style: @ActiveText; }
        TextButton #Class4EquipButton { Anchor: (Left: 618, Top: 10, Width: 124, Height: 30); Text: "Equip"; Style: @ButtonStyle; }
