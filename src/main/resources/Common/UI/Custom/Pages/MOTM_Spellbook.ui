      Group #AbilityCard2 { Anchor: (Left: 256, Top: 244, Width: 230, Height: 170); Background: PatchStyle(Color: @PanelSoft); Label #Ability2Name { Anchor: (Left: 12, Top: 10, Width: 204, Height: 22); Style: @ValueText; } Label #Ability2Id { Anchor: (Left: 12, Top: 36, Width: 204, Height: 18); Style: @SmallText; } Label #Ability2Summary { Anchor: (Left: 12, Top: 60, Width: 204, Height: 54); Style: @SmallText; } Label #Ability2Meta { Anchor: (Left: 12, Top: 116, Width: 204, Height: 42); Style: @SmallText; } }
      Group #AbilityCard3 { Anchor: (Left: 512, Top: 244, Width: 230, Height: 170); Background: PatchStyle(Color: @PanelSoft); Label #Ability3Name { Anchor: (Left: 12, Top: 10, Width: 204, Height: 22); Style: @ValueText; } Label #Ability3Id { Anchor: (Left: 12, Top: 36, Width: 204, Height: 18); Style: @SmallText; } Label #Ability3Summary { Anchor: (Left: 12, Top: 60, Width: 204, Height: 54); Style: @SmallText; } Label #Ability3Meta { Anchor: (Left: 12, Top: 116, Width: 204, Height: 42); Style: @SmallText; } }
    }

    Group #PerksPanel {
