@PanelBg = #111720(0.94);
@PanelSoft = #1a2230(0.88);
@PanelLine = #344052(0.70);
@Text = #eef3f7;
@Muted = #b3bfcb;
@Accent = #d8aa53;
@Good = #98d982;

@SmallText = (FontSize: 13, TextColor: @Muted, Wrap: true);
@BodyText = (FontSize: 15, TextColor: @Text, Wrap: true);
@TitleText = (FontSize: 28, RenderBold: true, TextColor: @Text);
@ValueText = (FontSize: 15, RenderBold: true, TextColor: @Good, Wrap: true);
@NavText = (FontSize: 14, RenderBold: true, TextColor: @Text);
@ButtonStyle = (
  Default: (
    Background: PatchStyle(Color: @PanelSoft),
    LabelStyle: @NavText
  ),
  Hovered: (
    Background: PatchStyle(Color: #263143(0.94)),
    LabelStyle: (...@NavText, TextColor: @Accent)
  ),
  Pressed: (
    Background: PatchStyle(Color: #3a2d1e(0.95)),
    LabelStyle: (...@NavText, TextColor: #ffffff)
  )
);

Group #Root {
  Anchor: (Width: 1040, Height: 704);
  Background: PatchStyle(Color: @PanelBg);

  Group #NavRail {
    Anchor: (Left: 24, Top: 24, Width: 176, Height: 656);
    Background: PatchStyle(Color: #0b1018(0.96));

    Label #SpellbookTitle {
      Anchor: (Left: 14, Top: 12, Width: 148, Height: 32);
      Text: "MOTM";
      Style: (FontSize: 25, RenderBold: true, TextColor: @Accent);
    }

    Label #SpellbookSubtitle {
      Anchor: (Left: 14, Top: 43, Width: 148, Height: 30);
      Text: "Spellbook";
      Style: @SmallText;
    }

    TextButton #NavOverviewButton { Anchor: (Left: 14, Top: 92, Width: 148, Height: 34); Text: "Overview"; Style: @ButtonStyle; }
    Label #NavOverviewSelected { Anchor: (Left: 14, Top: 92, Width: 148, Height: 34); Text: "> Overview"; Visible: false; Style: (...@NavText, VerticalAlignment: Center, TextColor: @Accent); }

    TextButton #NavClassButton { Anchor: (Left: 14, Top: 132, Width: 148, Height: 34); Text: "Class"; Style: @ButtonStyle; }
    Label #NavClassSelected { Anchor: (Left: 14, Top: 132, Width: 148, Height: 34); Text: "> Class"; Visible: false; Style: (...@NavText, VerticalAlignment: Center, TextColor: @Accent); }

    TextButton #NavAbilitiesButton { Anchor: (Left: 14, Top: 172, Width: 148, Height: 34); Text: "Abilities"; Style: @ButtonStyle; }
    Label #NavAbilitiesSelected { Anchor: (Left: 14, Top: 172, Width: 148, Height: 34); Text: "> Abilities"; Visible: false; Style: (...@NavText, VerticalAlignment: Center, TextColor: @Accent); }

    TextButton #NavPerksButton { Anchor: (Left: 14, Top: 212, Width: 148, Height: 34); Text: "Perks"; Style: @ButtonStyle; }
    Label #NavPerksSelected { Anchor: (Left: 14, Top: 212, Width: 148, Height: 34); Text: "> Perks"; Visible: false; Style: (...@NavText, VerticalAlignment: Center, TextColor: @Accent); }

    TextButton #NavStatsButton { Anchor: (Left: 14, Top: 252, Width: 148, Height: 34); Text: "Stats"; Style: @ButtonStyle; }
    Label #NavStatsSelected { Anchor: (Left: 14, Top: 252, Width: 148, Height: 34); Text: "> Stats"; Visible: false; Style: (...@NavText, VerticalAlignment: Center, TextColor: @Accent); }

    Label #ActionStatus {
      Anchor: (Left: 14, Top: 410, Width: 148, Height: 190);
      Text: "";
      Style: (...@SmallText, TextColor: #d9dde7);
    }
  }

  Group #HeroPanel {
    Anchor: (Left: 224, Top: 24, Width: 792, Height: 132);
    Background: PatchStyle(Color: @PanelSoft);

    Label #SectionTitle { Anchor: (Left: 22, Top: 14, Width: 450, Height: 36); Style: @TitleText; }
    Label #SectionSubtitle { Anchor: (Left: 22, Top: 54, Width: 450, Height: 42); Style: @BodyText; }
    Label #HeroNextStep { Anchor: (Left: 22, Top: 98, Width: 450, Height: 20); Style: (...@SmallText, TextColor: @Accent); }

    Label #HeroClassValue { Anchor: (Left: 510, Top: 18, Width: 250, Height: 18); Style: @ValueText; }
    Label #HeroBuildValue { Anchor: (Left: 510, Top: 42, Width: 250, Height: 18); Style: @ValueText; }
    Label #HeroStyleValue { Anchor: (Left: 510, Top: 66, Width: 250, Height: 18); Style: @ValueText; }
    Label #HeroLevelValue { Anchor: (Left: 510, Top: 90, Width: 250, Height: 18); Style: @ValueText; }
    Label #HeroProgress { Anchor: (Left: 510, Top: 112, Width: 250, Height: 16); Style: @SmallText; }
  }

  Group #ContentRoot {
    Anchor: (Left: 224, Top: 172, Width: 792, Height: 508);
    Background: PatchStyle(Color: #0f141c(0.90));

    Group #OverviewPanel {
      Anchor: (Left: 18, Top: 18, Width: 756, Height: 472);
      Label #OverviewIdentityClassValue { Anchor: (Left: 0, Top: 0, Width: 350, Height: 22); Style: @ValueText; }
      Label #OverviewIdentityBuildValue { Anchor: (Left: 0, Top: 30, Width: 350, Height: 22); Style: @ValueText; }
      Label #OverviewIdentityStyleValue { Anchor: (Left: 0, Top: 60, Width: 350, Height: 22); Style: @ValueText; }
      Label #OverviewIdentityLevelValue { Anchor: (Left: 0, Top: 90, Width: 350, Height: 22); Style: @ValueText; }
      Label #OverviewPathNextStepValue { Anchor: (Left: 392, Top: 0, Width: 350, Height: 44); Style: @BodyText; }
      Label #OverviewPathPendingPerksValue { Anchor: (Left: 392, Top: 54, Width: 350, Height: 22); Style: @ValueText; }
      Label #OverviewPathSynergyValue { Anchor: (Left: 392, Top: 84, Width: 350, Height: 22); Style: @ValueText; }
      Label #OverviewPathCastingValue { Anchor: (Left: 0, Top: 142, Width: 742, Height: 44); Style: @BodyText; }
      Label #OverviewPathTipValue { Anchor: (Left: 0, Top: 205, Width: 742, Height: 64); Style: @SmallText; }
    }

    Group #ClassPanel {
      Anchor: (Left: 18, Top: 18, Width: 756, Height: 472);
      Visible: false;
      Label #ClassInfoClassValue { Anchor: (Left: 0, Top: 0, Width: 300, Height: 22); Style: @ValueText; }
      Label #ClassInfoThemeValue { Anchor: (Left: 0, Top: 28, Width: 360, Height: 34); Style: @BodyText; }
      Label #ClassInfoElementValue { Anchor: (Left: 0, Top: 68, Width: 300, Height: 20); Style: @SmallText; }
      Label #ClassInfoPassiveNameValue { Anchor: (Left: 0, Top: 96, Width: 360, Height: 22); Style: @ValueText; }
      Label #ClassInfoPassiveDescValue { Anchor: (Left: 0, Top: 124, Width: 360, Height: 70); Style: @SmallText; }
      Label #ClassInfoClassActionValue { Anchor: (Left: 0, Top: 202, Width: 360, Height: 44); Style: @SmallText; }
      TextButton #ClassTerraButton { Anchor: (Left: 0, Top: 256, Width: 170, Height: 32); Text: "Terra"; Style: @ButtonStyle; }
      TextButton #ClassHydroButton { Anchor: (Left: 190, Top: 256, Width: 170, Height: 32); Text: "Hydro"; Style: @ButtonStyle; }
      TextButton #ClassAeroButton { Anchor: (Left: 0, Top: 296, Width: 170, Height: 32); Text: "Aero"; Style: @ButtonStyle; }
      TextButton #ClassCorruptusButton { Anchor: (Left: 190, Top: 296, Width: 170, Height: 32); Text: "Corruptus"; Style: @ButtonStyle; }
      TextButton #ClassChooseButton { Anchor: (Left: 0, Top: 340, Width: 360, Height: 34); Text: "Choose"; Style: @ButtonStyle; }

      Label #ClassInfoStyleIntroValue { Anchor: (Left: 392, Top: 0, Width: 340, Height: 22); Style: @ValueText; }
      Label #ClassInfoStyleRuleValue { Anchor: (Left: 392, Top: 28, Width: 340, Height: 45); Style: @SmallText; }
      Label #ClassInfoAbilityRuleValue { Anchor: (Left: 392, Top: 78, Width: 340, Height: 45); Style: @SmallText; }
      Label #ClassInfoStyleActionValue { Anchor: (Left: 392, Top: 130, Width: 340, Height: 42); Style: @SmallText; }
      TextButton #RemovedOptionButton1 { Anchor: (Left: 392, Top: 184, Width: 108, Height: 28); Text: ""; Visible: false; Style: @ButtonStyle; }
      TextButton #RemovedOptionButton2 { Anchor: (Left: 512, Top: 184, Width: 108, Height: 28); Text: ""; Visible: false; Style: @ButtonStyle; }
      TextButton #RemovedOptionButton3 { Anchor: (Left: 632, Top: 184, Width: 108, Height: 28); Text: ""; Visible: false; Style: @ButtonStyle; }
      TextButton #RemovedOptionButton4 { Anchor: (Left: 392, Top: 218, Width: 108, Height: 28); Text: ""; Visible: false; Style: @ButtonStyle; }
      TextButton #RemovedOptionButton5 { Anchor: (Left: 512, Top: 218, Width: 108, Height: 28); Text: ""; Visible: false; Style: @ButtonStyle; }
      TextButton #RemovedOptionButton6 { Anchor: (Left: 632, Top: 218, Width: 108, Height: 28); Text: ""; Visible: false; Style: @ButtonStyle; }
      TextButton #RemovedOptionButton7 { Anchor: (Left: 392, Top: 252, Width: 108, Height: 28); Text: ""; Visible: false; Style: @ButtonStyle; }
      TextButton #RemovedOptionButton8 { Anchor: (Left: 512, Top: 252, Width: 108, Height: 28); Text: ""; Visible: false; Style: @ButtonStyle; }
      TextButton #RemovedOptionButton9 { Anchor: (Left: 632, Top: 252, Width: 108, Height: 28); Text: ""; Visible: false; Style: @ButtonStyle; }
      TextButton #RemovedOptionButton10 { Anchor: (Left: 392, Top: 286, Width: 108, Height: 28); Text: ""; Visible: false; Style: @ButtonStyle; }
      TextButton #RemovedOptionButton11 { Anchor: (Left: 512, Top: 286, Width: 108, Height: 28); Text: ""; Visible: false; Style: @ButtonStyle; }
      TextButton #RemovedOptionButton12 { Anchor: (Left: 632, Top: 286, Width: 108, Height: 28); Text: ""; Visible: false; Style: @ButtonStyle; }
      Label #ClassInfoStyleValue { Anchor: (Left: 392, Top: 338, Width: 340, Height: 20); Style: @ValueText; }
      Label #ClassInfoProgressValue { Anchor: (Left: 392, Top: 364, Width: 340, Height: 20); Style: @SmallText; }
      Label #ClassInfoMilestoneValue { Anchor: (Left: 392, Top: 390, Width: 340, Height: 20); Style: @SmallText; }
      Label #ClassInfoPromptValue { Anchor: (Left: 392, Top: 416, Width: 340, Height: 38); Style: (...@BodyText, TextColor: @Accent); }
    }

    Group #AbilitiesPanel {
      Anchor: (Left: 18, Top: 18, Width: 756, Height: 472);
      Visible: false;
      Label #AbilitiesEmpty { Anchor: (Left: 0, Top: 0, Width: 742, Height: 32); Style: @BodyText; }
      Group #AbilitiesDetails {
