      Group #PerksChoicesContainer { Anchor: (Left: 0, Top: 126, Width: 742, Height: 248);
        Group #PerkRow1 { Anchor: (Left: 0, Top: 0, Width: 742, Height: 22); Label #Perk1Index { Anchor: (Left: 0, Top: 0, Width: 40, Height: 20); Style: @SmallText; } Label #Perk1Name { Anchor: (Left: 42, Top: 0, Width: 180, Height: 20); Style: @ValueText; } Label #Perk1Desc { Anchor: (Left: 230, Top: 0, Width: 392, Height: 20); Style: @SmallText; } TextButton #PerkButton1 { Anchor: (Left: 636, Top: 0, Width: 92, Height: 22); Text: "Queue"; Style: @ButtonStyle; } }
