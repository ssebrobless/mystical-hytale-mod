        TextButton #StyleButton5 { Anchor: (Left: 0, Top: 68, Width: 160, Height: 28); Text: "Style 5"; Style: @ButtonStyle; }
        TextButton #StyleButton6 { Anchor: (Left: 176, Top: 68, Width: 160, Height: 28); Text: "Style 6"; Style: @ButtonStyle; }
        TextButton #StyleButton7 { Anchor: (Left: 0, Top: 102, Width: 160, Height: 28); Text: "Style 7"; Style: @ButtonStyle; }
