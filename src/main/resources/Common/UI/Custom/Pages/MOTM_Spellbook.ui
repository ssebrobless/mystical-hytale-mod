      Label #OverviewIdentityRaceValue { Anchor: (Left: 0, Top: 30, Width: 350, Height: 22); Style: @ValueText; }
      Label #OverviewIdentityStyleValue { Anchor: (Left: 0, Top: 60, Width: 350, Height: 22); Style: @ValueText; }
