      TextButton #RaceButton11 { Anchor: (Left: 512, Top: 286, Width: 108, Height: 28); Text: "Race 11"; Style: @ButtonStyle; }
      TextButton #RaceButton12 { Anchor: (Left: 632, Top: 286, Width: 108, Height: 28); Text: "Race 12"; Style: @ButtonStyle; }
