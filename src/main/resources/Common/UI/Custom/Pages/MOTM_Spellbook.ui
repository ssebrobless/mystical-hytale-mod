@PanelBg = #050608(0.86);
@PanelSoft = #18130f(0.94);
@PanelLine = #3c2d1e(0.78);
@Text = #f1ebe0;
@Muted = #bda98c;
@Accent = #d8aa53;
@Good = #e7c58d;

@SmallText = (FontSize: 13, TextColor: @Muted, Wrap: true);
@BodyText = (FontSize: 15, TextColor: @Text, Wrap: true);
@TitleText = (FontSize: 30, RenderBold: true, TextColor: @Text);
@ValueText = (FontSize: 16, RenderBold: true, TextColor: @Good, Wrap: true);
@NavText = (FontSize: 15, RenderBold: true, TextColor: @Text);
@ButtonStyle = (
  Default: (
    Background: PatchStyle(Color: @PanelSoft),
    LabelStyle: @NavText
  ),
  Hovered: (
    Background: PatchStyle(Color: #2b2119(0.96)),
    LabelStyle: (...@NavText, TextColor: @Accent)
  ),
  Pressed: (
    Background: PatchStyle(Color: #3a2d1e(0.95)),
    LabelStyle: (...@NavText, TextColor: #ffffff)
  )
);

Group #Root {
  Anchor: (Width: 1180, Height: 830);
  Background: PatchStyle(Color: @PanelBg);

  Group #NavRail {
    Anchor: (Left: 24, Top: 24, Width: 210, Height: 782);
    Background: PatchStyle(Color: #100b09(0.98));

    Label #SpellbookTitle {
      Anchor: (Left: 16, Top: 18, Width: 178, Height: 38);
      Text: "Mentees";
      Style: (FontSize: 27, RenderBold: true, TextColor: @Accent);
    }

    Label #SpellbookSubtitle {
      Anchor: (Left: 16, Top: 54, Width: 178, Height: 30);
      Text: "Spellbook";
      Style: @SmallText;
    }

    TextButton #NavOverviewButton { Anchor: (Left: 16, Top: 112, Width: 178, Height: 42); Text: "Class"; Style: @ButtonStyle; }
    Label #NavOverviewSelected { Anchor: (Left: 16, Top: 112, Width: 178, Height: 42); Text: "> Class"; Visible: false; Style: (...@NavText, VerticalAlignment: Center, TextColor: @Accent); }

    TextButton #NavJourneyButton { Anchor: (Left: 16, Top: 162, Width: 178, Height: 42); Text: ""; Visible: false; Style: @ButtonStyle; }
    Label #NavJourneySelected { Anchor: (Left: 16, Top: 162, Width: 178, Height: 42); Text: ""; Visible: false; Style: (...@NavText, VerticalAlignment: Center, TextColor: @Accent); }

    TextButton #NavGrimoireButton { Anchor: (Left: 16, Top: 162, Width: 178, Height: 42); Text: "Styles + Abilities"; Style: @ButtonStyle; }
    Label #NavGrimoireSelected { Anchor: (Left: 16, Top: 162, Width: 178, Height: 42); Text: "> Styles"; Visible: false; Style: (...@NavText, VerticalAlignment: Center, TextColor: @Accent); }

    TextButton #NavPerksButton { Anchor: (Left: 16, Top: 212, Width: 178, Height: 42); Text: "Perks"; Style: @ButtonStyle; }
    Label #NavPerksSelected { Anchor: (Left: 16, Top: 212, Width: 178, Height: 42); Text: "> Perks"; Visible: false; Style: (...@NavText, VerticalAlignment: Center, TextColor: @Accent); }

    TextButton #NavResourcesButton { Anchor: (Left: 16, Top: 312, Width: 178, Height: 42); Text: ""; Visible: false; Style: @ButtonStyle; }
    Label #NavResourcesSelected { Anchor: (Left: 16, Top: 312, Width: 178, Height: 42); Text: ""; Visible: false; Style: (...@NavText, VerticalAlignment: Center, TextColor: @Accent); }

    TextButton #NavCodexButton { Anchor: (Left: 16, Top: 262, Width: 178, Height: 42); Text: "Stats"; Style: @ButtonStyle; }
    Label #NavCodexSelected { Anchor: (Left: 16, Top: 262, Width: 178, Height: 42); Text: "> Stats"; Visible: false; Style: (...@NavText, VerticalAlignment: Center, TextColor: @Accent); }

    TextButton #NavJournalButton { Anchor: (Left: 16, Top: 362, Width: 178, Height: 42); Text: ""; Visible: false; Style: @ButtonStyle; }
    Label #NavJournalSelected { Anchor: (Left: 16, Top: 362, Width: 178, Height: 42); Text: ""; Visible: false; Style: (...@NavText, VerticalAlignment: Center, TextColor: @Accent); }

    Label #ActionStatus {
      Anchor: (Left: 16, Top: 604, Width: 178, Height: 150);
      Text: "";
      Style: (...@SmallText, TextColor: #d9dde7);
    }
  }

  Group #HeroPanel {
    Anchor: (Left: 258, Top: 24, Width: 898, Height: 170);
    Background: PatchStyle(Color: @PanelSoft);

    Label #SectionTitle { Anchor: (Left: 24, Top: 18, Width: 486, Height: 40); Style: @TitleText; }
    Label #SectionSubtitle { Anchor: (Left: 24, Top: 62, Width: 486, Height: 44); Style: @BodyText; }
    Label #HeroNextStep { Anchor: (Left: 24, Top: 116, Width: 486, Height: 26); Style: (...@SmallText, TextColor: @Accent); }

    Label #HeroClassValue { Anchor: (Left: 558, Top: 22, Width: 300, Height: 22); Style: @ValueText; }
    Label #HeroRaceValue { Anchor: (Left: 558, Top: 50, Width: 300, Height: 22); Style: @ValueText; }
    Label #HeroStyleValue { Anchor: (Left: 558, Top: 78, Width: 300, Height: 22); Style: @ValueText; }
    Label #HeroLevelValue { Anchor: (Left: 558, Top: 106, Width: 300, Height: 22); Style: @ValueText; }
    Label #HeroProgress { Anchor: (Left: 558, Top: 134, Width: 300, Height: 18); Style: @SmallText; }
  }

  Group #ContentRoot {
